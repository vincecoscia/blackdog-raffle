# MongoDB Atlas connection string (Employees + Raffles collections live here).
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# Google OAuth client (https://console.cloud.google.com/apis/credentials).
GOOGLE_ID=
GOOGLE_SECRET=

# Where the app is served; next-auth needs it for OAuth callbacks.
NEXTAUTH_URL=http://localhost:3000

# Signs the session JWT. Generate one with: openssl rand -base64 32
# (`SECRET` is still honoured for existing deployments.)
NEXTAUTH_SECRET=

# Who may sign in: comma-separated email suffixes, e.g. "@blackdogadvertising.com"
# or "@blackdogadvertising.com,you@gmail.com" to let a personal account in.
EMAIL_WHITELIST=@blackdogadvertising.com

# Optional: post winner cards to a Google Chat space. In the space: space name →
# Apps & integrations → Webhooks → Add webhook, then paste the URL here.
# Leave empty to hide the "Share to Google Chat" button.
GOOGLE_CHAT_WEBHOOK_URL=
